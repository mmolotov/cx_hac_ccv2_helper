{
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go mod:*)",
      "Bash(go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@*)",
      "Bash(gofmt:*)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make race)",
      "Bash(make cover)",
      "Bash(make vet)",
      "Bash(make lint)",
      "Bash(make check)",
      "Bash(./bin/hac flexsearch:*)",
      "Bash(./bin/hac count:*)",
      "Bash(./bin/hac enumcodes:*)",
      "Bash(./bin/hac cronjobs:*)",
      "Bash(./bin/hac uptime:*)",
      "Bash(./bin/hac config get:*)",
      "Bash(./bin/hac auth status:*)",
      "Bash(./bin/hac --help)",
      "Bash(./bin/hac --version)"
    ],
    "ask": [
      "Bash(./bin/hac groovy:*)",
      "Bash(./bin/hac config set:*)",
      "Bash(./bin/hac loglevel:*)",
      "Bash(./bin/hac cache:*)",
      "Bash(./bin/hac credentials:*)",
      "Bash(./bin/hac auth:*)",
      "Bash(./bin/hac config setup:*)",
      "Bash(./bin/hac config refresh:*)"
    ],
    "deny": [
      "Read(./.config/**)",
      "Read(~/.config/hac/**)",
      "Edit(./.config/**)",
      "Edit(~/.config/hac/**)",
      "Bash(cat .config/*)",
      "Bash(cat ./.config/*)",
      "Bash(cat ~/.config/hac/*)",
      "Bash(*credentials.enc*)",
      "Bash(*sessions/*.json*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gofmt.sh", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/go-test.sh", "timeout": 300 }
        ]
      }
    ]
  }
}
